{
  "name": "@galaxy-stack/orbit-logger",
  "version": "0.6.1",
  "description": "Structured logging module for Orbit framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --packages external",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "build:types": "bash scripts/build-types.sh",
    "changeset": "changeset"
  },
  "dependencies": {
    "@galaxy-stack/orbit-core": "^0.2.0",
    "@galaxy-stack/orbit-common": "^0.1.13"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.0"
  },
  "keywords": [
    "orbit",
    "bun",
    "logger",
    "logging",
    "structured-logging",
    "json-logging"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaxy-orbit/orbit-logger.git"
  },
  "bugs": {
    "url": "https://github.com/galaxy-orbit/orbit-cli/issues"
  },
  "homepage": "https://galaxy-orbit-framework.vercel.app",
  "devDependencies": {
    "reflect-metadata": "^0.2.2",
    "@changesets/cli": "^2.27.0",
    "@types/bun": "latest"
  }
}
